# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Audit pepper -- READ THIS ONE
# ---------------------------------------------------------------------------
# Keys the HMAC that turns a matched value into a correlation fingerprint.
#
# Generate your own:
#
#     openssl rand -hex 32
#
# The service REFUSES TO START if this is unset, empty, shorter than 32
# characters, or still the placeholder below. That is deliberate: the Egyptian
# national ID space is small enough to enumerate exhaustively (a century digit,
# a birth date, a governorate from a list of 27, a check digit), so an unkeyed
# or publicly-known-key digest of one is equivalent to storing the ID itself.
#
# Keep it OUT of the database. The whole security property is that a dump of
# pii_events is useless without this value, so storing it next to the data it
# protects defeats the exercise. A secrets manager, a Docker secret, or an
# environment variable injected at deploy time -- not a row in Postgres.
#
# Rotating it is a one-way door: existing fingerprints stop matching new ones,
# and they cannot be recomputed because the values were never stored. Rotate
# only on suspected compromise, and expect correlation history to reset.
PII_AUDIT_PEPPER=CHANGE_ME__openssl_rand_hex_32

# ---------------------------------------------------------------------------
# Audit database (separate from LiteLLM's -- do not point this at that one)
# ---------------------------------------------------------------------------
PII_DB_USER=pii
PII_DB_PASSWORD=CHANGE_ME__openssl_rand_hex_24
PII_DB_NAME=pii

# ---------------------------------------------------------------------------
# Joining the existing LiteLLM deployment
# ---------------------------------------------------------------------------
# The docker network your LiteLLM stack already runs on. Find it with:
#
#     docker network ls
#
# It is usually <compose-project-name>_default.
LITELLM_NETWORK=litellm

# ---------------------------------------------------------------------------
# Build time only (optional)
# ---------------------------------------------------------------------------
# Path to a CA bundle, if an internal TLS-intercepting proxy sits in front of
# PyPI. Common at the sites this ships to. Left unset, the build uses the
# image's own trust store and this changes nothing.
#
# An internal PyPI mirror is passed at build time instead:
#   docker compose build --build-arg PIP_INDEX_URL=https://nexus.internal/...
# PIP_CA_BUNDLE=/etc/ssl/certs/corporate-ca.pem
# The same, for the npm registry the web UI is built from. Separate because a
# site may mirror one and not the other.
# NPM_CA_BUNDLE=/etc/ssl/certs/corporate-ca.pem

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
PII_LOG_LEVEL=INFO
PII_LANGUAGES=en,ar
PII_DETECTION_CACHE_SIZE=2048
PII_IMAGE_TAG=0.1.0

# ---------------------------------------------------------------------------
# Admin API (runtime policy editing)
# ---------------------------------------------------------------------------
# Bearer token for /admin, where custom tier-3 labels and replacement policy
# are managed. UNSET BY DEFAULT, which disables those routes entirely: a
# deployment that has not deliberately turned on runtime policy editing should
# not expose it.
#
#     openssl rand -hex 32
#
# This is a placeholder for the phase-2 role auth the brief specifies
# (ADMIN_EMAIL / ADMIN_INITIAL_PASSWORD, admin and auditor roles). It is
# all-or-nothing: there is no read-only auditor yet, and anyone holding it can
# change what the gateway masks. Pass X-Admin-User on each call so the
# custom_entities.updated_by column records who made the change.
PII_ADMIN_TOKEN=
#
# The same value is handed to pii-api (see docker-compose.yml), which
# authenticates the operator itself and forwards their email as X-Admin-User,
# so custom_entities.updated_by names a person and not a shared token. Leave it
# empty and the admin menu's Entities screen reports itself disabled.
#
#     openssl rand -hex 32

# ---------------------------------------------------------------------------
# Detection tiers
# ---------------------------------------------------------------------------
# Tier 1 (deterministic recognizers) is always on and needs nothing here.

# Tier 2: Arabic NER (ONNX int8) plus the address gazetteer.
# Requires a model directory containing model.onnx, tokenizer.json and
# labels.json. Enabling this without one is a startup error, not a silent
# downgrade. See README, "Tier 2 model artifact".
# The variant has been decided by measurement: camelbert-msa-int8, the only
# one of the four exported artifacts to clear the coverage gate. See the
# README, "Result -- camelbert-msa-int8", including why it clears it by only
# two spans and why the dialect-pretrained variant lost.
#
# Still false by default: turning it on needs the artifact present under
# PII_MODEL_HOST_DIR, and it adds ~33 ms p95 to every Arabic chat message
# (and ~560 ms to a long pasted Arabic document) on pre_call.
PII_ENABLE_TIER2_ARABIC_NER=false
PII_TIER2_MODEL_DIR=/models/camelbert-msa-int8
PII_MODEL_HOST_DIR=./models

# Tier 3: GLiNER2 for Latin-script text. Runs on PyTorch.
#
# READ THIS BEFORE ENABLING IT. The gliner package declares torch AND
# transformers as core dependencies -- not optional ones -- so tier 3 is the
# only feature here that changes what kind of image you are shipping. Measured:
# 570 MB without it, 6.12 GB with it -- 10.7x -- and the "one docker load
# tarball someone can carry into an air-gapped site" property goes with it.
# The weights are a further ~1.2 GB on top.
#
# The image therefore does not install it unless you ask:
#
#     PII_WITH_TIER3=true docker compose build pii-service
#
# Enabling the flag below without that build is a startup error, not a silent
# downgrade.
#
# Weights: point PII_TIER3_MODEL_DIR at a directory saved with
# GLiNER.save_pretrained (~1.2 GB). Loading uses local_files_only, so an
# air-gapped host fails clearly rather than hanging on a fetch.
#
# Latency, measured on an i7-10700K: p50 67 ms / p95 74 ms on Latin chat text,
# and nothing on Arabic-only text because the router never hands tier 3 a
# non-Latin run. This runs pre_call, so it lands on every request carrying
# Latin text. Re-measure under concurrent load before enabling it on a busy
# gateway -- those numbers are sequential and single-threaded.
#
# Known limit: predict_entities truncates to the model's 384-token window, so
# a long paste is only partly scanned. Measured: nothing at all is found in a
# 2.8 kB document.
PII_WITH_TIER3=false
PII_ENABLE_TIER3_GLINER=false
PII_TIER3_MODEL_DIR=/models/gliner-multi-pii

# ---------------------------------------------------------------------------
# Web app (pii-api + pii-web)
# ---------------------------------------------------------------------------
# Bootstraps the first admin account. It is created flagged
# must_change_password, and the console refuses to serve the admin and chat
# routes until that password is rotated -- so this value is a one-time
# credential, not a standing one. The service refuses to start if it is unset,
# still the placeholder below, or shorter than 12 characters.
#
#     openssl rand -base64 24
PII_API_ADMIN_EMAIL=admin@example.com
PII_API_ADMIN_INITIAL_PASSWORD=CHANGE_ME__initial_admin_password

# The proxy's master key. pii-api uses it to mint ONE LiteLLM virtual key per
# application user, which is what puts a real user id on the audit rows the
# chat produces. Without it every chat message would audit to the same key and
# the admin view could not answer "who".
PII_API_LITELLM_MASTER_KEY=CHANGE_ME__litellm_master_key
PII_API_LITELLM_URL=http://litellm:4000
PII_API_CHAT_MODEL=local-llama

# Set false ONLY for local http development. A session cookie without Secure
# is a session cookie that rides a downgraded request.
PII_API_COOKIE_SECURE=true

# Where the UI is published. Bound to loopback by default.
PII_WEB_BIND=127.0.0.1
PII_WEB_PORT=8099
