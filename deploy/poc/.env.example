# Copy to .env, then run ./up.sh -- which fills in every CHANGE_ME below with
# a generated value if you have not.
#
# Proof of concept. Deployed on a workstation with internet access, not a
# hardened host: the defaults here favour "it works when you run it" over the
# separations a real deployment needs. Differences are listed in the README.

# ---------------------------------------------------------------------------
# Secrets. ./up.sh generates all four.
# ---------------------------------------------------------------------------
PII_AUDIT_PEPPER=CHANGE_ME
PII_DB_PASSWORD=CHANGE_ME
PII_ADMIN_TOKEN=CHANGE_ME
PII_API_ADMIN_INITIAL_PASSWORD=CHANGE_ME
LITELLM_MASTER_KEY=CHANGE_ME
LITELLM_SALT_KEY=CHANGE_ME

# ---------------------------------------------------------------------------
# Who signs in
# ---------------------------------------------------------------------------
# Created flagged must_change_password. The console refuses the admin and chat
# routes until it is rotated, so this is a one-time credential.
PII_API_ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# Where the UI is published
# ---------------------------------------------------------------------------
POC_BIND=127.0.0.1
POC_PORT=8099

# ---------------------------------------------------------------------------
# The model
# ---------------------------------------------------------------------------
# Pulled into the ollama volume on first start. llama3.1 is ~4.7 GB.
POC_OLLAMA_MODEL=llama3.1

# ---------------------------------------------------------------------------
# Tiers -- all on, which is the point of the demo
# ---------------------------------------------------------------------------
# Tier 2 (Arabic NER) and tier 3 (Latin-script NER) are both enabled, and their
# artifacts are downloaded and prepared on first start by the pii-models
# container. Nothing is baked into the image: the first `up` fetches roughly
# 1.4 GB of weights, and every start after that skips what is already there.
PII_ENABLE_TIER2_ARABIC_NER=true
PII_ENABLE_TIER3_GLINER=true
PII_TIER2_MODEL_DIR=/models/camelbert-msa-int8
PII_TIER3_MODEL_DIR=/models/gliner-multi-pii

PII_LOG_LEVEL=INFO
PII_IMAGE_TAG=poc
