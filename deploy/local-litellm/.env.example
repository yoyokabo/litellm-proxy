# Copy to .env in this directory. Local test deployment only -- these are not
# the credentials of the real proxy, which this repository does not own.
#
#   cp .env.example .env
#   sed -i "s/^LITELLM_MASTER_KEY=.*/LITELLM_MASTER_KEY=sk-$(openssl rand -hex 16)/" .env
#   sed -i "s/^LITELLM_SALT_KEY=.*/LITELLM_SALT_KEY=$(openssl rand -hex 32)/" .env

# Admin key for the proxy. Must start with "sk-".
LITELLM_MASTER_KEY=sk-CHANGE_ME

# Encrypts credentials LiteLLM stores in its own database. Rotating it
# invalidates them, so generate once and leave it alone.
LITELLM_SALT_KEY=CHANGE_ME

LITELLM_DB_PASSWORD=litellm
